QMainWindow, QWidget#CentralRoot {
    background-color: #FFFFFF;
    color: #1D1D1F;
    font-family: -apple-system, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "Segoe UI", sans-serif;
    font-size: 13px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #FFFFFF;
}

/* ==========================================================================
   MenuBar & Dialog Menus
   ========================================================================== */
QMenuBar {
    background-color: #ECECEC;
    border-bottom: 1px solid #D9D9D9;
    padding: 2px 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    color: #1D1D1F;
    background: transparent;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: rgba(0, 0, 0, 0.05);
}

QMenu {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D2;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px 6px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #007AFF;
    color: #FFFFFF;
}

/* ==========================================================================
   Left Sidebar Navigation
   ========================================================================== */
QFrame#Sidebar {
    background-color: #ECECEC;
    border-right: 1px solid #D9D9D9;
}

QLabel#BrandIcon {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    color: #007AFF;
}

QLabel#BrandTitle {
    font-size: 15px;
    font-weight: 700;
    color: #1D1D1F;
    letter-spacing: -0.2px;
}

QFrame#SidebarSeparator {
    background-color: #D2D2D2;
    margin: 0 16px;
}

/* Sidebar Button Item */
QFrame#SidebarBtn {
    background-color: transparent;
    border-radius: 5px;
    margin: 2px 10px;
    border: none;
}

QFrame#SidebarBtn[hover="true"] {
    background-color: rgba(0, 0, 0, 0.04);
}

QFrame#SidebarBtn[active="true"] {
    background-color: #007AFF;
}

QLabel#SidebarBtnIcon {
    font-family: "Segoe Fluent Icons";
    font-size: 13px;
    color: #555555;
}

QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnIcon {
    color: #FFFFFF;
}

QLabel#SidebarBtnText {
    font-size: 13px;
    font-weight: 500;
    color: #1D1D1F;
}

QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnText {
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#SidebarFooter {
    font-size: 11px;
    color: #8E8E93;
    font-weight: 500;
}

/* Dynamic Status Dot Indicator */
QLabel#StatusDot {
    border-radius: 4px;
    background-color: #8E8E93;
}

QLabel#StatusDot[status="running"] {
    background-color: #28CD41;
}

QLabel#StatusDot[status="stopped"] {
    background-color: #FF3B30;
}

QLabel#StatusDot[status="partial"] {
    background-color: #FF9500;
}

/* ==========================================================================
   Main Pages Content Container
   ========================================================================== */
QStackedWidget#MainPages {
    background-color: #FFFFFF;
}

QWidget#TabPage {
    background-color: #FFFFFF;
}

QLabel#PageTitle {
    font-size: 26px;
    font-weight: 700;
    color: #1D1D1F;
    letter-spacing: -0.5px;
}

QLabel#SectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: #8E8E93;
    letter-spacing: 0.5px;
}

QLabel#BodyText {
    font-size: 13px;
    color: #515154;
    line-height: 18px;
}

QLabel#SummaryTitle {
    font-size: 20px;
    font-weight: 700;
    color: #1D1D1F;
    letter-spacing: -0.3px;
}

QLabel#RowTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1D1D1F;
}

QLabel#RowMeta, QLabel#ValueText, QLabel#MetaText {
    font-size: 11px;
    color: #8E8E93;
}

/* ==========================================================================
   Flat Cards and Custom Panels
   ========================================================================== */
QFrame#Panel {
    background-color: #FAFAFC;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
}

QFrame#QuickAccessCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
}

QFrame#QuickAccessCard[hover="true"] {
    background-color: #F5F5F7;
    border-color: #D2D2D7;
}

QFrame#QuickAccessIconBox {
    background-color: #F2F2F7;
    border-radius: 6px;
}

QLabel#QuickAccessIconGlyph {
    color: #007AFF;
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    font-weight: 400;
}

QLabel#QuickAccessTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1D1D1F;
}

QLabel#QuickAccessSubtitle {
    font-size: 11px;
    color: #8E8E93;
}

/* ==========================================================================
   Service Status Rows
   ========================================================================== */
QFrame#ServiceRow {
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-left: 4px solid #D2D2D7;
    border-radius: 8px;
}

QFrame#ServiceRow[status="running"] {
    border-left-color: #28CD41;
}

QFrame#ServiceRow[status="stopped"] {
    border-left-color: #FF3B30;
}

QFrame#ServiceRow[status="partial"] {
    border-left-color: #FF9500;
}

QFrame#StatusIconBox {
    border-radius: 6px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    background-color: #F2F2F7;
}

QFrame#StatusIconBox[status="running"] {
    background-color: #E2F9E5;
}

QFrame#StatusIconBox[status="stopped"] {
    background-color: #FFE8E7;
}

QFrame#StatusIconBox[status="partial"] {
    background-color: #FFF2E2;
}

QLabel#StatusIconGlyph {
    font-family: "Segoe Fluent Icons";
    font-size: 14px;
    color: #8E8E93;
}

QLabel#StatusIconGlyph[status="running"] {
    color: #28CD41;
}

QLabel#StatusIconGlyph[status="stopped"] {
    color: #FF3B30;
}

QLabel#StatusIconGlyph[status="partial"] {
    color: #FF9500;
}

/* Badges - Pill-shaped Status Indicators */
QLabel#StatusBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    background-color: #F2F2F7;
    color: #555555;
}

QLabel#StatusBadge[status="running"] {
    background-color: #E2F9E5;
    color: #28CD41;
}

QLabel#StatusBadge[status="stopped"] {
    background-color: #FFE8E7;
    color: #FF3B30;
}

QLabel#StatusBadge[status="partial"] {
    background-color: #FFF2E2;
    color: #FF9500;
}

QLabel#MetaBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    color: #8E8E93;
    background-color: #FFFFFF;
    border: 1px solid #E5E5EA;
}

/* ==========================================================================
   macOS Style Button Form Controls
   ========================================================================== */
QPushButton {
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    min-height: {{BUTTON_HEIGHT}}px;
}

QPushButton#PrimaryButton {
    background-color: #007AFF;
    color: #FFFFFF;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #0066D6;
}

QPushButton#PrimaryButton:pressed {
    background-color: #0055B3;
}

QPushButton#DangerButton {
    background-color: #FF3B30;
    color: #FFFFFF;
    border: none;
}

QPushButton#DangerButton:hover {
    background-color: #E02E24;
}

QPushButton#DangerButton:pressed {
    background-color: #C1231B;
}

QPushButton#DefaultButton {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D2;
}

QPushButton#DefaultButton:hover {
    background-color: #F5F5F7;
}

QPushButton#DefaultButton:pressed {
    background-color: #EAEAEA;
}

QPushButton:disabled {
    background-color: #F5F5F7;
    color: #AEAEB2;
    border-color: #E5E5EA;
}

/* ==========================================================================
   Textfields, Select boxes, Scrollbars
   ========================================================================== */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1D1D1F;
    border: 1px solid #D2D2D2;
    border-radius: 5px;
    font-size: 13px;
}

QLineEdit, QSpinBox, QComboBox {
    padding: 5px 8px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1px solid #007AFF;
}

QPlainTextEdit {
    padding: 10px;
    background-color: #FAFAFC;
    border-color: #E5E5EA;
    selection-background-color: #007AFF;
    selection-color: #FFFFFF;
}
