QMainWindow, QWidget#CentralRoot {
    background-color: #151413; /* Deep warm organic charcoal canvas */
    color: #F5F3F0; /* Creamy off-white text */
    font-family: -apple-system, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "Segoe UI", sans-serif;
    font-size: 13px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #151413;
}

/* ==========================================================================
   MenuBar & Dialog Menus
   ========================================================================== */
QMenuBar {
    background-color: #0C0B0A;
    border-bottom: 1px solid #252321;
    padding: 2px 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    color: #A59E96;
    background: transparent;
    border-radius: 6px;
    font-weight: 600;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.05);
    color: #F5F3F0;
}

QMenu {
    background-color: #201E1D;
    color: #F5F3F0;
    border: 1px solid #2D2A28;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px 6px 16px;
    border-radius: 6px;
    color: #F5F3F0;
}

QMenu::item:selected {
    background-color: #E55B3C;
    color: #FFFFFF;
}

/* ==========================================================================
   Left Sidebar Navigation (Obsidian Clay Sidebar)
   ========================================================================== */
QFrame#Sidebar {
    background-color: #0C0B0A;
    border-right: 1px solid #201E1D;
}

QLabel#BrandIcon {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    color: #E55B3C;
}

QLabel#BrandTitle {
    font-size: 15px;
    font-weight: 800;
    color: #F5F3F0;
    letter-spacing: -0.3px;
}

QFrame#SidebarSeparator {
    background-color: #201E1D;
    margin: 0 16px;
}

/* Sidebar Button Item */
QFrame#SidebarBtn {
    background-color: transparent;
    border-radius: 10px;
    margin: 3px 12px;
    border: none;
}

QFrame#SidebarBtn[hover="true"] {
    background-color: rgba(255, 255, 255, 0.04);
}

QFrame#SidebarBtn[active="true"] {
    background-color: #E55B3C;
}

QLabel#SidebarBtnIcon {
    font-family: "Segoe Fluent Icons";
    font-size: 13px;
    color: #8C8780;
}

QLabel#SidebarBtnIcon[active="true"],
QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnIcon {
    color: #FFFFFF;
}

QLabel#SidebarBtnText {
    font-size: 13px;
    font-weight: 600;
    color: #8C8780;
}

QLabel#SidebarBtnText[active="true"],
QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnText {
    color: #FFFFFF;
    font-weight: 700;
}

QLabel#SidebarFooter {
    font-size: 11px;
    color: #5E5B56;
    font-weight: 600;
}

/* Dynamic Status Dot Indicator */
QLabel#StatusDot {
    border-radius: 4px;
    background-color: #5E5B56;
}

QLabel#StatusDot[status="running"] {
    background-color: #5D9D4E; /* Sage Green */
}

QLabel#StatusDot[status="stopped"] {
    background-color: #D35E46; /* Clay Rust */
}

QLabel#StatusDot[status="partial"] {
    background-color: #D59F45; /* Ochre Yellow */
}

/* ==========================================================================
   Main Pages Content Container
   ========================================================================== */
QStackedWidget#MainPages {
    background-color: #151413;
}

QWidget#TabPage {
    background-color: #151413;
}

QLabel#PageTitle {
    font-size: 26px;
    font-weight: 800;
    color: #F5F3F0;
    letter-spacing: -0.5px;
}

QLabel#SectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: #8C8780;
    letter-spacing: 0.8px;
}

QLabel#BodyText {
    font-size: 12px;
    color: #A59E96;
    line-height: 18px;
}

QLabel#SummaryTitle {
    font-size: 18px;
    font-weight: 800;
    color: #F5F3F0;
    letter-spacing: -0.3px;
}

QLabel#RowTitle {
    font-size: 13px;
    font-weight: 700;
    color: #F5F3F0;
}

QLabel#RowMeta, QLabel#ValueText, QLabel#MetaText {
    font-size: 11px;
    color: #8C8780;
    font-weight: 500;
}

/* ==========================================================================
   Flat Cards and Custom Panels (Clay Obsidian - 16px Rounded)
   ========================================================================== */
QFrame#Panel {
    background-color: #201E1D;
    border: 1px solid #2D2A28;
    border-radius: 16px;
}

QFrame#QuickAccessCard {
    background-color: #201E1D;
    border: 1px solid #2D2A28;
    border-radius: 16px;
}

QFrame#QuickAccessCard[hover="true"] {
    background-color: #2D2A28;
    border-color: #3C3835;
}

QFrame#QuickAccessIconBox {
    background-color: #2D2A28;
    border-radius: 10px;
}

QLabel#QuickAccessIconGlyph {
    color: #E55B3C;
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    font-weight: 400;
}

QLabel#QuickAccessTitle {
    font-size: 13px;
    font-weight: 700;
    color: #F5F3F0;
}

QLabel#QuickAccessSubtitle {
    font-size: 11px;
    color: #8C8780;
}

/* ==========================================================================
   Service Status Rows (Cohesive Clay status palettes)
   ========================================================================== */
QFrame#ServiceRow {
    background-color: #201E1D;
    border: 1px solid #2D2A28;
    border-left: 4px solid #3C3835;
    border-radius: 16px;
}

QFrame#ServiceRow[status="running"] {
    border-left-color: #5D9D4E;
}

QFrame#ServiceRow[status="stopped"] {
    border-left-color: #D35E46;
}

QFrame#ServiceRow[status="partial"] {
    border-left-color: #D59F45;
}

QFrame#StatusIconBox {
    border-radius: 8px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    background-color: #2D2A28;
}

QFrame#StatusIconBox[status="running"] {
    background-color: #1D2D1F;
}

QFrame#StatusIconBox[status="stopped"] {
    background-color: #341C18;
}

QFrame#StatusIconBox[status="partial"] {
    background-color: #322619;
}

QLabel#StatusIconGlyph {
    font-family: "Segoe Fluent Icons";
    font-size: 14px;
    color: #8C8780;
}

QLabel#StatusIconGlyph[status="running"] {
    color: #5D9D4E;
}

QLabel#StatusIconGlyph[status="stopped"] {
    color: #D35E46;
}

QLabel#StatusIconGlyph[status="partial"] {
    color: #D59F45;
}

/* Badges - Pill-shaped Status Indicators */
QLabel#StatusBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: #2D2A28;
    color: #8C8780;
}

QLabel#StatusBadge[status="running"] {
    background-color: #1D2D1F;
    color: #A6D2A0;
}

QLabel#StatusBadge[status="stopped"] {
    background-color: #341C18;
    color: #E68471;
}

QLabel#StatusBadge[status="partial"] {
    background-color: #322619;
    color: #EAB05E;
}

QLabel#MetaBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    color: #A59E96;
    background-color: #201E1D;
    border: 1px solid #2D2A28;
}

/* ==========================================================================
   macOS Style Button Form Controls (Terracotta Accent & 12px Rounded)
   ========================================================================== */
QPushButton {
    border-radius: 12px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    min-height: {{BUTTON_HEIGHT}}px;
}

QPushButton#PrimaryButton {
    background-color: #E55B3C;
    color: #FFFFFF;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #CC4E30;
}

QPushButton#PrimaryButton:pressed {
    background-color: #B23F23;
}

QPushButton#DangerButton {
    background-color: #D94E34;
    color: #FFFFFF;
    border: none;
}

QPushButton#DangerButton:hover {
    background-color: #C13F27;
}

QPushButton#DangerButton:pressed {
    background-color: #A8311B;
}

QPushButton#DefaultButton {
    background-color: #201E1D;
    color: #F5F3F0;
    border: 1px solid #3C3835;
}

QPushButton#DefaultButton:hover {
    background-color: #2D2A28;
    border-color: #8C8780;
}

QPushButton#DefaultButton:pressed {
    background-color: #3C3835;
}

QPushButton#ThemeToggleBtn {
    background-color: #201E1D;
    color: #F5F3F0;
    border: 1px solid #3C3835;
    min-height: 28px;
    padding: 4px 10px;
    border-radius: 8px;
}

QPushButton#ThemeToggleBtn:hover {
    background-color: #2D2A28;
}

QPushButton:disabled {
    background-color: #201E1D;
    color: #5E5B56;
    border-color: #2D2A28;
}

/* ==========================================================================
   Textfields, Select boxes, Scrollbars
   ========================================================================== */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background-color: #201E1D;
    color: #F5F3F0;
    border: 1px solid #3C3835;
    border-radius: 8px;
    font-size: 13px;
}

QLineEdit, QSpinBox, QComboBox {
    padding: 5px 8px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1.5px solid #E55B3C;
}

QPlainTextEdit {
    padding: 10px;
    background-color: #201E1D;
    border-color: #2D2A28;
    selection-background-color: #E55B3C;
    selection-color: #FFFFFF;
}

QLabel#SidebarCredit {
    font-size: 11px;
    color: #5E5B56;
    font-weight: 600;
}

/* Custom Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #4E4A46;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #E55B3C;
}

QScrollBar::handle:vertical:pressed {
    background-color: #CC4E30;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #4E4A46;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #E55B3C;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #CC4E30;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Custom SpinBoxes */
QSpinBox {
    padding: 6px 30px 6px 12px;
    background-color: #201E1D;
    border: 1px solid #2D2A28;
    border-radius: 12px;
    color: #FAF9F6;
    font-size: 13px;
    font-weight: 500;
}

QSpinBox:focus {
    border-color: #E55B3C;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #2D2A28;
    border-top-right-radius: 12px;
    background-color: #282523;
}

QSpinBox::up-button:hover {
    background-color: #34302D;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border-left: 1px solid #2D2A28;
    border-bottom-right-radius: 12px;
    background-color: #282523;
}

QSpinBox::down-button:hover {
    background-color: #34302D;
}

QSpinBox::up-arrow {
    image: url("{{ASSETS_PATH}}/chevron_up_dark.svg");
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow:hover {
    image: url("{{ASSETS_PATH}}/chevron_up_accent.svg");
}

QSpinBox::down-arrow {
    image: url("{{ASSETS_PATH}}/chevron_down_dark.svg");
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow:hover {
    image: url("{{ASSETS_PATH}}/chevron_down_accent.svg");
}
