/* ===================================================================
   DevStack Manager — Light Theme (Windows 11 / WinUI 3)
   Accent: terracotta #E55B3C
   =================================================================== */

QMainWindow, QWidget#CentralRoot {
    background-color: #F3F3F3;
    color: #1C1C1C;
    font-family: "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
    font-size: 13px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #F3F3F3;
}

/* ── Menu bar ─────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #F3F3F3;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 0 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    color: #1C1C1C;
    background: transparent;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 400;
}

QMenuBar::item:selected {
    background-color: rgba(0,0,0,0.05);
}

QMenu {
    background-color: #FFFFFF;
    color: #1C1C1C;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 16px;
    border-radius: 4px;
    font-size: 13px;
}

QMenu::item:selected {
    background-color: #E55B3C;
    color: #FFFFFF;
}

/* ── Sidebar / NavigationView ─────────────────────────────────────── */
QFrame#Sidebar {
    background-color: #F9F9F9;
    border-right: 1px solid rgba(0,0,0,0.06);
}

QLabel#BrandTitle {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #1C1C1C;
}

QFrame#SidebarSeparator {
    background-color: rgba(0,0,0,0.06);
    margin: 0 12px;
}

/* Inactive nav item */
QFrame#SidebarBtn {
    background-color: transparent;
    border-radius: 4px;
    margin: 1px 8px;
    border: none;
}

QFrame#SidebarBtn[hover="true"] {
    background-color: rgba(0,0,0,0.04);
}

/* Active nav item — WinUI 3 style: tinted bg + left accent bar */
QFrame#SidebarBtn[active="true"] {
    background-color: rgba(229, 91, 60, 0.10);
    border-left: 3px solid #E55B3C;
    border-radius: 0px 4px 4px 0px;
    margin-left: 0px;
}

/* Nav icon — Segoe Fluent Icons / MDL2 Assets */
QLabel#SidebarBtnIcon {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 14px;
    color: #5C5C5C;
    font-weight: 400;
}

QLabel#SidebarBtnIcon[active="true"],
QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnIcon {
    color: #E55B3C;
}

QLabel#SidebarBtnText {
    font-size: 13px;
    font-weight: 400;
    color: #3C3C3C;
}

QLabel#SidebarBtnText[active="true"],
QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnText {
    color: #E55B3C;
    font-weight: 600;
}

QLabel#SidebarFooter {
    font-size: 11px;
    color: #9C9C9C;
    font-weight: 400;
}

QLabel#SidebarCredit {
    font-size: 11px;
    color: #BEBEBE;
    font-weight: 400;
}

/* Status dot in brand row */
QLabel#StatusDot {
    border-radius: 4px;
    background-color: #BEBEBE;
}

QLabel#StatusDot[status="running"] { background-color: #107C10; }
QLabel#StatusDot[status="stopped"] { background-color: #C42B1C; }
QLabel#StatusDot[status="partial"]  { background-color: #9D5D00; }

/* Theme toggle button */
QPushButton#ThemeToggleBtn {
    min-height: 28px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 400;
    border-radius: 4px;
    color: #5C5C5C;
    background-color: transparent;
    border: 1px solid rgba(0,0,0,0.10);
}

QPushButton#ThemeToggleBtn:hover {
    background-color: rgba(0,0,0,0.04);
    border-color: rgba(0,0,0,0.14);
}

/* ── Content area ────────────────────────────────────────────────── */
QStackedWidget#MainPages, QWidget#TabPage {
    background-color: #F3F3F3;
}

QLabel#PageTitle {
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #1C1C1C;
}

QLabel#SectionLabel {
    font-size: 11px;
    font-weight: 600;
    color: #767676;
    letter-spacing: 0.5px;
}

QLabel#BodyText {
    font-size: 13px;
    color: #5C5C5C;
}

QLabel#SummaryTitle {
    font-size: 16px;
    font-weight: 600;
    color: #1C1C1C;
}

QLabel#RowTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1C1C1C;
}

QLabel#RowMeta, QLabel#ValueText, QLabel#MetaText {
    font-size: 12px;
    color: #767676;
    font-weight: 400;
}

/* ── Cards / Panels ─────────────────────────────────────────────── */
QFrame#Panel {
    background-color: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 8px;
}

QFrame#QuickAccessCard {
    background-color: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.05);
    border-radius: 8px;
}

QFrame#QuickAccessCard[hover="true"] {
    background-color: #F5F5F5;
    border-color: rgba(0,0,0,0.09);
}

QFrame#QuickAccessIconBox {
    background-color: #F3F3F3;
    border-radius: 6px;
}

QLabel#QuickAccessIconGlyph {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 16px;
    color: #E55B3C;
}

QLabel#QuickAccessTitle {
    font-size: 13px;
    font-weight: 600;
    color: #1C1C1C;
}

QLabel#QuickAccessSubtitle {
    font-size: 12px;
    color: #767676;
}

/* ── Service rows ───────────────────────────────────────────────── */
QFrame#ServiceRow {
    background-color: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.05);
    border-left: 3px solid #BEBEBE;
    border-radius: 8px;
}

QFrame#ServiceRow[status="running"] { border-left-color: #107C10; }
QFrame#ServiceRow[status="stopped"] { border-left-color: #C42B1C; }
QFrame#ServiceRow[status="partial"]  { border-left-color: #9D5D00; }

QFrame#StatusIconBox {
    border-radius: 6px;
    min-width: 32px; max-width: 32px;
    min-height: 32px; max-height: 32px;
    background-color: #F3F3F3;
}

QFrame#StatusIconBox[status="running"] { background-color: #DFF6DD; }
QFrame#StatusIconBox[status="stopped"] { background-color: #FDE7E9; }
QFrame#StatusIconBox[status="partial"]  { background-color: #FFF4CE; }

QLabel#StatusIconGlyph {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets";
    font-size: 14px;
    color: #9C9C9C;
}
QLabel#StatusIconGlyph[status="running"] { color: #107C10; }
QLabel#StatusIconGlyph[status="stopped"] { color: #C42B1C; }
QLabel#StatusIconGlyph[status="partial"]  { color: #9D5D00; }

/* ── Status badges (pill shape) ─────────────────────────────────── */
QLabel#StatusBadge {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
    background-color: #EFEFEF;
    color: #767676;
}

QLabel#StatusBadge[status="running"] { background-color: #DFF6DD; color: #0B6A0B; }
QLabel#StatusBadge[status="stopped"] { background-color: #FDE7E9; color: #A4262C; }
QLabel#StatusBadge[status="partial"]  { background-color: #FFF4CE; color: #7A4100; }


/* ── Buttons ────────────────────────────────────────────────────── */
QPushButton {
    background-color: #FFFFFF;
    color: #1C1C1C;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 4px;
    padding: 5px 16px;
    font-size: 13px;
    font-weight: 400;
    min-height: {{BUTTON_HEIGHT}}px;
}

QPushButton:hover {
    background-color: #F5F5F5;
    border-color: rgba(0,0,0,0.14);
}

QPushButton:pressed {
    background-color: #EBEBEB;
}

QPushButton#PrimaryButton {
    background-color: #E55B3C;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover    { background-color: #CC4E30; }
QPushButton#PrimaryButton:pressed  { background-color: #B23F23; }

/* Danger — outlined style (reversible action) */
QPushButton#DangerButton {
    background-color: #FFFFFF;
    color: #C42B1C;
    border: 1px solid rgba(196, 43, 28, 0.4);
    font-weight: 600;
}

QPushButton#DangerButton:hover {
    background-color: rgba(196, 43, 28, 0.06);
    border-color: #C42B1C;
}

QPushButton#DangerButton:pressed {
    background-color: rgba(196, 43, 28, 0.12);
}

QPushButton#DefaultButton {
    background-color: #FFFFFF;
    color: #1C1C1C;
    border: 1px solid rgba(0,0,0,0.10);
}

QPushButton#DefaultButton:hover   { background-color: #F5F5F5; border-color: rgba(0,0,0,0.14); }
QPushButton#DefaultButton:pressed { background-color: #EBEBEB; }

QPushButton:disabled {
    background-color: #F3F3F3;
    color: #BEBEBE;
    border-color: rgba(0,0,0,0.06);
}

/* ── Progress bar (indeterminate busy indicator) ─────────────────── */
QProgressBar {
    background-color: rgba(0,0,0,0.06);
    border: none;
    border-radius: 2px;
}
QProgressBar::chunk {
    background-color: #E55B3C;
    border-radius: 2px;
}

/* ── Form inputs ─────────────────────────────────────────────────── */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1C1C1C;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 4px;
    font-size: 13px;
}

QLineEdit, QComboBox {
    padding: 5px 10px;
    min-height: 32px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 2px solid #E55B3C;
}

QPlainTextEdit {
    padding: 10px;
    border-color: rgba(0,0,0,0.07);
    selection-background-color: #E55B3C;
    selection-color: #FFFFFF;
}

/* ── SpinBox ─────────────────────────────────────────────────────── */
QSpinBox {
    padding: 5px 32px 5px 10px;
    min-height: 32px;
    background-color: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 4px;
    color: #1C1C1C;
    font-size: 13px;
    font-weight: 400;
}

QSpinBox:focus { border: 2px solid #E55B3C; }

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid rgba(0,0,0,0.08);
    border-top-right-radius: 4px;
    background-color: #F5F5F5;
}

QSpinBox::up-button:hover { background-color: #EBEBEB; }

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 26px;
    border-left: 1px solid rgba(0,0,0,0.08);
    border-bottom-right-radius: 4px;
    background-color: #F5F5F5;
}

QSpinBox::down-button:hover { background-color: #EBEBEB; }

QSpinBox::up-arrow   { image: url("{{ASSETS_PATH}}/chevron_up.svg");   width: 10px; height: 10px; }
QSpinBox::up-arrow:hover   { image: url("{{ASSETS_PATH}}/chevron_up_accent.svg"); }
QSpinBox::down-arrow { image: url("{{ASSETS_PATH}}/chevron_down.svg"); width: 10px; height: 10px; }
QSpinBox::down-arrow:hover { image: url("{{ASSETS_PATH}}/chevron_down_accent.svg"); }

/* ── Scrollbars ──────────────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 6px;
    margin: 2px 0;
}

QScrollBar::handle:vertical {
    background-color: rgba(0,0,0,0.18);
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover   { background-color: #E55B3C; }
QScrollBar::handle:vertical:pressed { background-color: #CC4E30; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; background: none; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 6px;
    margin: 0 2px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(0,0,0,0.18);
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover   { background-color: #E55B3C; }
QScrollBar::handle:horizontal:pressed { background-color: #CC4E30; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; background: none; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Misc ────────────────────────────────────────────────────────── */
