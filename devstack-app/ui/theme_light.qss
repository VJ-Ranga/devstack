QMainWindow, QWidget#CentralRoot {
    background-color: #F5F3F0; /* Premium warm ivory paper background */
    color: #1E1B18; /* Deep warm charcoal */
    font-family: -apple-system, "SF Pro Text", "SF Pro Display", "Helvetica Neue", "Segoe UI", sans-serif;
    font-size: 13px;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #F5F3F0;
}

/* ==========================================================================
   MenuBar & Dialog Menus
   ========================================================================== */
QMenuBar {
    background-color: #EBEBE6;
    border-bottom: 1px solid #D9D6CE;
    padding: 2px 4px;
}

QMenuBar::item {
    padding: 6px 12px;
    color: #1E1B18;
    background: transparent;
    border-radius: 6px;
    font-weight: 600;
}

QMenuBar::item:selected {
    background-color: rgba(0, 0, 0, 0.04);
}

QMenu {
    background-color: #FFFFFF;
    color: #1E1B18;
    border: 1px solid #E5E2DC;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px 6px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #E55B3C;
    color: #FFFFFF;
}

/* ==========================================================================
   Left Sidebar Navigation (Warm Clay Sidebar)
   ========================================================================== */
QFrame#Sidebar {
    background-color: #EBEBE6;
    border-right: 1px solid #D9D6CE;
}

QLabel#BrandIcon {
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    color: #E55B3C;
}

QLabel#BrandTitle {
    font-size: 15px;
    font-weight: 800;
    color: #1E1B18;
    letter-spacing: -0.3px;
}

QFrame#SidebarSeparator {
    background-color: #D9D6CE;
    margin: 0 16px;
}

/* Sidebar Button Item */
QFrame#SidebarBtn {
    background-color: transparent;
    border-radius: 10px;
    margin: 3px 12px;
    border: none;
}

QFrame#SidebarBtn[hover="true"] {
    background-color: rgba(0, 0, 0, 0.03);
}

QFrame#SidebarBtn[active="true"] {
    background-color: #E55B3C; /* Accent Orange */
}

QLabel#SidebarBtnIcon {
    font-family: "Segoe Fluent Icons";
    font-size: 13px;
    color: #5E5B56;
}

QLabel#SidebarBtnIcon[active="true"],
QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnIcon {
    color: #FFFFFF;
}

QLabel#SidebarBtnText {
    font-size: 13px;
    font-weight: 600;
    color: #5E5B56;
}

QLabel#SidebarBtnText[active="true"],
QFrame#SidebarBtn[active="true"] QLabel#SidebarBtnText {
    color: #FFFFFF;
    font-weight: 700;
}

QLabel#SidebarFooter {
    font-size: 11px;
    color: #8C8780;
    font-weight: 600;
}

/* Dynamic Status Dot Indicator */
QLabel#StatusDot {
    border-radius: 4px;
    background-color: #8C8780;
}

QLabel#StatusDot[status="running"] {
    background-color: #4B7D3F; /* Organic Sage Green */
}

QLabel#StatusDot[status="stopped"] {
    background-color: #C24F36; /* Organic Clay Rust */
}

QLabel#StatusDot[status="partial"] {
    background-color: #BF8E3B; /* Organic Ochre Yellow */
}

/* ==========================================================================
   Main Pages Content Container
   ========================================================================== */
QStackedWidget#MainPages {
    background-color: #F5F3F0;
}

QWidget#TabPage {
    background-color: #F5F3F0;
}

QLabel#PageTitle {
    font-size: 26px;
    font-weight: 800;
    color: #1E1B18;
    letter-spacing: -0.5px;
}

QLabel#SectionLabel {
    font-size: 11px;
    font-weight: 700;
    color: #8C8780;
    letter-spacing: 0.8px;
}

QLabel#BodyText {
    font-size: 12px; /* Eye-friendly body size */
    color: #5E5B56;
    line-height: 18px;
}

QLabel#SummaryTitle {
    font-size: 18px;
    font-weight: 800;
    color: #1E1B18;
    letter-spacing: -0.3px;
}

QLabel#RowTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1E1B18;
}

QLabel#RowMeta, QLabel#ValueText, QLabel#MetaText {
    font-size: 11px;
    color: #8C8780;
    font-weight: 500;
}

/* ==========================================================================
   Flat Cards and Custom Panels (16px Rounded Cards)
   ========================================================================== */
QFrame#Panel {
    background-color: #FFFFFF;
    border: 1px solid #E5E2DC;
    border-radius: 16px;
}

QFrame#QuickAccessCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E2DC;
    border-radius: 16px;
}

QFrame#QuickAccessCard[hover="true"] {
    background-color: #FAF9F6;
    border-color: #D9D6CE;
}

QFrame#QuickAccessIconBox {
    background-color: #F5F3F0;
    border-radius: 10px;
}

QLabel#QuickAccessIconGlyph {
    color: #E55B3C;
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    font-weight: 400;
}

QLabel#QuickAccessTitle {
    font-size: 13px;
    font-weight: 700;
    color: #1E1B18;
}

QLabel#QuickAccessSubtitle {
    font-size: 11px;
    color: #8C8780;
}

/* ==========================================================================
   Service Status Rows (Cohesive Clay status palettes)
   ========================================================================== */
QFrame#ServiceRow {
    background-color: #FFFFFF;
    border: 1px solid #E5E2DC;
    border-left: 4px solid #D9D6CE;
    border-radius: 16px;
}

QFrame#ServiceRow[status="running"] {
    border-left-color: #4B7D3F;
}

QFrame#ServiceRow[status="stopped"] {
    border-left-color: #C24F36;
}

QFrame#ServiceRow[status="partial"] {
    border-left-color: #BF8E3B;
}

QFrame#StatusIconBox {
    border-radius: 8px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    background-color: #F5F3F0;
}

QFrame#StatusIconBox[status="running"] {
    background-color: #E6ECE4;
}

QFrame#StatusIconBox[status="stopped"] {
    background-color: #F5E9E6;
}

QFrame#StatusIconBox[status="partial"] {
    background-color: #F5EDE2;
}

QLabel#StatusIconGlyph {
    font-family: "Segoe Fluent Icons";
    font-size: 14px;
    color: #8C8780;
}

QLabel#StatusIconGlyph[status="running"] {
    color: #4B7D3F;
}

QLabel#StatusIconGlyph[status="stopped"] {
    color: #C24F36;
}

QLabel#StatusIconGlyph[status="partial"] {
    color: #BF8E3B;
}

/* Badges - Pill-shaped Status Indicators */
QLabel#StatusBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
    background-color: #F5F3F0;
    color: #8C8780;
}

QLabel#StatusBadge[status="running"] {
    background-color: #E6ECE4;
    color: #335E28;
}

QLabel#StatusBadge[status="stopped"] {
    background-color: #F5E9E6;
    color: #9C3A25;
}

QLabel#StatusBadge[status="partial"] {
    background-color: #F5EDE2;
    color: #8F621D;
}

QLabel#MetaBadge {
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    color: #5E5B56;
    background-color: #FFFFFF;
    border: 1px solid #E5E2DC;
}

/* ==========================================================================
   macOS Style Button Form Controls (Terracotta Accent & 8px Rounded)
   ========================================================================== */
QPushButton {
    border-radius: 6px;
    font-size: 12px;
}

QPushButton#PrimaryButton, QPushButton#DefaultButton, QPushButton#DangerButton {
    border-radius: 8px;
    padding: 4px 12px;
    font-weight: 700;
    min-height: {{BUTTON_HEIGHT}}px;
}

QPushButton#PrimaryButton {
    background-color: #E55B3C;
    color: #FFFFFF;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #CC4E30;
}

QPushButton#PrimaryButton:pressed {
    background-color: #B23F23;
}

QPushButton#DangerButton {
    background-color: #D94E34;
    color: #FFFFFF;
    border: none;
}

QPushButton#DangerButton:hover {
    background-color: #C13F27;
}

QPushButton#DangerButton:pressed {
    background-color: #A8311B;
}

QPushButton#DefaultButton {
    background-color: #FFFFFF;
    color: #1E1B18;
    border: 1px solid #D9D6CE;
}

QPushButton#DefaultButton:hover {
    background-color: #FAF9F6;
    border-color: #8C8780;
}

QPushButton#DefaultButton:pressed {
    background-color: #EBEBE6;
}

QPushButton#ThemeToggleBtn {
    background-color: #FFFFFF;
    color: #1E1B18;
    border: 1px solid #D9D6CE;
    min-height: 28px;
    padding: 4px 10px;
    border-radius: 8px;
}

QPushButton#ThemeToggleBtn:hover {
    background-color: #FAF9F6;
}

QPushButton:disabled {
    background-color: #EBEBE6;
    color: #8C8780;
    border-color: #D9D6CE;
}

/* ==========================================================================
   Textfields, Select boxes, Scrollbars
   ========================================================================== */
QLineEdit, QSpinBox, QComboBox, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #1E1B18;
    border: 1px solid #D9D6CE;
    border-radius: 8px;
    font-size: 13px;
}

QLineEdit, QSpinBox, QComboBox {
    padding: 5px 8px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus {
    border: 1.5px solid #E55B3C;
}

QPlainTextEdit {
    padding: 10px;
    background-color: #FFFFFF;
    border-color: #E5E2DC;
    selection-background-color: #E55B3C;
    selection-color: #FFFFFF;
}

QLabel#SidebarCredit {
    font-size: 11px;
    color: #8C8780;
    font-weight: 600;
}

/* Custom Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #D1CDC5;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #E55B3C;
}

QScrollBar::handle:vertical:pressed {
    background-color: #CC4E30;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: transparent;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #D1CDC5;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #E55B3C;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #CC4E30;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Custom SpinBoxes */
QSpinBox {
    padding: 6px 30px 6px 12px;
    background-color: #FFFFFF;
    border: 1px solid #E5E2DC;
    border-radius: 12px;
    color: #1E1B18;
    font-size: 13px;
    font-weight: 500;
}

QSpinBox:focus {
    border-color: #E55B3C;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #E5E2DC;
    border-top-right-radius: 12px;
    background-color: #FAF9F6;
}

QSpinBox::up-button:hover {
    background-color: #EBEBE6;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 24px;
    border-left: 1px solid #E5E2DC;
    border-bottom-right-radius: 12px;
    background-color: #FAF9F6;
}

QSpinBox::down-button:hover {
    background-color: #EBEBE6;
}

QSpinBox::up-arrow {
    image: url("{{ASSETS_PATH}}/chevron_up.svg");
    width: 10px;
    height: 10px;
}

QSpinBox::up-arrow:hover {
    image: url("{{ASSETS_PATH}}/chevron_up_accent.svg");
}

QSpinBox::down-arrow {
    image: url("{{ASSETS_PATH}}/chevron_down.svg");
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow:hover {
    image: url("{{ASSETS_PATH}}/chevron_down_accent.svg");
}
